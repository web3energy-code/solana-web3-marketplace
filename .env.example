# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=5173

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings > API
# Project URL: https://[project-id].supabase.co
# Anon/Public Key: From the API section
# Service Role Key: From the API section (backend only - NEVER expose to browser)
# JWT Secret: From the Settings > API > JWT Settings

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Backend only (NEVER in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only
SUPABASE_JWT_SECRET=your-jwt-secret-from-settings

# ============================================================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ============================================================================
# Network: devnet (development) or mainnet-beta (production)
# Use devnet for testing, mainnet-beta for real transactions

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Your marketplace's Solana wallet address (where customers send payment)
RECEIVING_WALLET=your-solana-wallet-address-44chars

# Token mints for USDC (use devnet or mainnet addresses)
# Devnet USDC: 4zMMC9sZKeLbbJiHXU1MrZLyGpRqKXvxKniPZj2suVs
# Mainnet USDC: EPjFWdd5Au17plusvxSxDw5ed8dRTg2u9d1XAuto3c
SOL_USDC_MINT_DEVNET=4zMMC9sZKeLbbJiHXU1MrZLyGpRqKXvxKniPZj2suVs
SOL_USDC_MINT_MAINNET=EPjFWdd5Au17plusvxSxDw5ed8dRTg2u9d1XAuto3c

# Payment configuration
ALLOWED_PAYMENT_TOKENS=SOL,USDC
PRICE_PRECISION=9
MAX_PAYMENT_AGE_MINUTES=20
MIN_PAYMENT_SOL=0.001
MIN_PAYMENT_USDC=0.01

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT secret for session management (backend only)
JWT_SECRET=your-long-random-secret-min-32-chars
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_EXPIRY_DAYS=30

# CORS configuration
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# FILE STORAGE (Supabase Storage Bucket)
# ============================================================================
UPLOAD_BUCKET=marketplace-images
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ============================================================================
# DATABASE
# ============================================================================
# Supabase PostgreSQL connection - configured via Supabase UI
# Connection string is auto-generated in Supabase
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
